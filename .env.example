# Все переменные ОПЦИОНАЛЬНЫ.
# Скрипт работает без единой переменной окружения.

# --- Supabase (опционально, для облачной публикации) ---
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_KEY=your_service_key_here

# --- ntfy (опционально, для push-уведомлений) ---
# NTFY_TOPIC=my-schedule-topic
# NTFY_ADMIN_TOPIC=my-admin-topic
# NTFY_SERVER=https://ntfy.sh

# --- Telegram (зарезервировано, не используется) ---
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF
